  "defensives": [
    {
      "name": "Divine Shield",
      "spell_id": 642,
      "cooldown": 300,
      "duration": 8,
      "usage_rule": "Use to save yourself in an emergency or after a mistake, or in Mythic+ as a pseudo healing cooldown since removing yourself from the heal load is roughly a 20% group damage reduction; it also fully immunes Blessing of Sacrifice transfer damage.",
      "talent_gated": false
    },
    {
      "name": "Lay on Hands",
      "spell_id": 633,
      "cooldown": 600,
      "duration": null,
      "usage_rule": "Use to instantly fully heal a player who would otherwise die; treat it as a last-resort emergency button given its very long cooldown.",
      "talent_gated": false
    },
    {
      "name": "Blessing of Protection",
      "spell_id": 1022,
      "cooldown": 300,
      "duration": 10,
      "usage_rule": "Cast on an ally to immune physical damage or remove a deadly physical debuff like a bleed; remember it wipes the target's aggro, so do not use it on the tank unless asked, and with Echoing Blessings it also grants 15% magic reduction.",
      "talent_gated": false
    },
    {
      "name": "Blessing of Sacrifice",
      "spell_id": 6940,
      "cooldown": 60,
      "duration": 12,
      "usage_rule": "Use it often as your main external on a player taking heavy damage; it transfers a share of their damage to you, so watch your own health and avoid using it on tanks taking giant hits.",
      "talent_gated": false
    },
    {
      "name": "Divine Protection",
      "spell_id": 498,
      "cooldown": 60,
      "duration": 8,
      "usage_rule": "Press before a predictable burst of incoming damage to reduce magic damage taken; note it does not reduce Blessing of Sacrifice transfer damage.",
      "talent_gated": false
    }
  ],
