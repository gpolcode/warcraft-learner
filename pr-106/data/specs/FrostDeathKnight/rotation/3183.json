  "major_cooldowns": [
    {
      "name": "Pillar of Frost",
      "spell_id": 51271,
      "cooldown": 45,
      "duration": 12,
      "align_with_bloodlust": true,
      "opener_priority": 3,
      "usage_rule": "Use on cooldown and never hold it to avoid losing casts; it is the anchor for every other cooldown, so all burst (Frostwyrm's Fury, Reaper's Mark, Breath, trinkets) should overlap its Strength buff window."
    },
    {
      "name": "Frostwyrm's Fury",
      "spell_id": 279302,
      "cooldown": 120,
      "align_with_bloodlust": true,
      "opener_priority": 5,
      "usage_rule": "Never cast without Pillar of Frost active or you waste Chosen of Frostbrood; fire it shortly after Pillar of Frost and use the recall cast when you have the best buff overlap (Unholy Strength plus Bonegrinder) or can hit the most targets."
    },
    {
      "name": "Reaper's Mark",
      "spell_id": 439843,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "talent_gated": true,
      "usage_rule": "Deathbringer only - cast on cooldown on the same GCD as Pillar of Frost when available, and never reapply it to a target that already has the mark or you prematurely end the existing one."
    },
    {
      "name": "Breath of Sindragosa",
      "spell_id": 152279,
      "cooldown": 120,
      "align_with_bloodlust": true,
      "opener_priority": 4,
      "talent_gated": true,
      "usage_rule": "Talent-gated burst window - activate it during Pillar of Frost with at least 60 Runic Power pooled, then sustain it by keeping Runic Power above zero for the whole channel."
    },
    {
      "name": "Empower Rune Weapon",
      "spell_id": 47568,
      "cooldown": 105,
      "duration": 20,
      "align_with_bloodlust": true,
      "opener_priority": 1,
      "usage_rule": "Open with it when you hold 2 charges and refresh it during the cooldown window to generate Runes and Killing Machine; spend a charge whenever you are low on Runes and lack a Killing Machine proc."
    }
  ],
  "rules": [
    {
      "type": "opener",
      "priority": "critical",
      "description": "Open ERW into Pillar then dump cooldowns",
      "condition": null,
      "action": "Open with Empower Rune Weapon, then (as Deathbringer) Reaper's Mark, then Pillar of Frost, Breath of Sindragosa, and Frostwyrm's Fury before settling into the normal priority; sequence Reaper's Mark before Pillar to free an extra GCD inside the window."
    },
    {
      "type": "cooldown_pairing",
      "priority": "critical",
      "description": "Never cast Frostwyrm's Fury outside Pillar",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 279302,
        "spell_name": "Frostwyrm's Fury",
        "required_spell_id": 51271,
        "required_spell_name": "Pillar of Frost",
        "window_s": 12
      },
      "action": "Always cast Frostwyrm's Fury while Pillar of Frost is active; casting it without Pillar wastes the Chosen of Frostbrood extension and is a major DPS loss."
    },
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Pair Reaper's Mark with Pillar of Frost",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 439843,
        "spell_name": "Reaper's Mark",
        "required_spell_id": 51271,
        "required_spell_name": "Pillar of Frost",
        "window_s": 6
      },
      "action": "As Deathbringer, cast Reaper's Mark on the same GCD as Pillar of Frost so the Strength buff overlaps the Wave of Souls hits, especially in AoE."
    },
    {
      "type": "rotation",
      "priority": "critical",
      "description": "Always spend Killing Machine procs",
      "condition": null,
      "action": "Treat Killing Machine as your top priority and consume it with Obliterate (or Frostscythe in AoE) on the next GCD; do not intentionally bank two stacks, since two single-proc casts out-damage one double-consumed cast."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Spend Rime with Howling Blast",
      "condition": null,
      "action": "Cast Howling Blast whenever you have a Rime proc to keep Frostbound Will recovering Empower Rune Weapon faster; only hold a Rime proc to avoid Runic Power capping issues, never let it fall off."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Use Pillar of Frost on cooldown",
      "condition": null,
      "action": "Press Pillar of Frost as soon as it is available rather than holding it for mechanics; its short cooldown means held casts directly lose Killing Machine generation and total cooldown uptime."
    },
    {
      "type": "aoe_switch",
      "priority": "high",
      "description": "Swap to Frostscythe and Glacial Advance in AoE",
      "condition": null,
      "action": "At 3 or more targets replace Obliterate with Frostscythe and Frost Strike with Glacial Advance; the priority logic is otherwise identical to single target."
    },
    {
      "type": "positioning",
      "priority": "medium",
      "description": "Stay in melee for Remorseless Winter and cleave",
      "condition": null,
      "action": "Remain stacked in melee range so Remorseless Winter, Frostscythe, and Glacial Advance all reach the pack; stepping out drops your passive AoE and Killing Machine generation from Remorseless Winter."
    }
  ],
