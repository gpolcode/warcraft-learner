  "major_cooldowns": [
    {
      "name": "Avenging Wrath",
      "spell_id": 31884,
      "cooldown": 60,
      "duration": 20,
      "align_with_bloodlust": true,
      "opener_priority": 3,
      "usage_rule": "Use on cooldown after Avenger's Shield in the opener; it boosts damage, healing, and crit and turns Judgment into a Hammer of Wrath proc, so try to overlap it with Bloodlust, potions, and on-use trinkets."
    },
    {
      "name": "Divine Toll",
      "spell_id": 375576,
      "cooldown": 60,
      "align_with_bloodlust": true,
      "opener_priority": 4,
      "usage_rule": "Use on cooldown, ideally inside Avenging Wrath and when you are at 0 Holy Power, to fire Avenger's Shield at up to five targets and generate a large burst of Holy Power."
    },
    {
      "name": "Hammer of Light",
      "spell_id": 427453,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "opener_priority": 5,
      "usage_rule": "As Templar, cast immediately after Divine Toll once the Hammer of Light proc is active to spend the empowered finisher; treated as talent-gated since it only exists on the Templar hero build."
    },
    {
      "name": "Holy Bulwark",
      "spell_id": 432459,
      "cooldown": 60,
      "duration": 10,
      "align_with_bloodlust": false,
      "usage_rule": "As Lightsmith, summon via Holy Armaments and use charges proactively before Avenging Wrath windows or incoming damage for the absorb shield; talent-gated to the Lightsmith hero build.",
      "talent_gated": true
    },
    {
      "name": "Sacred Weapon",
      "spell_id": 432472,
      "cooldown": 60,
      "duration": 25,
      "align_with_bloodlust": false,
      "usage_rule": "As Lightsmith, apply via Holy Armaments while you are NOT inside Avenging Wrath to keep the weapon-empower buff active for extra damage; talent-gated to the Lightsmith hero build.",
      "talent_gated": true
    }
  ],
  "rules": [
    {
      "type": "opener",
      "priority": "high",
      "description": "Opener: Avenger's Shield into Wrath into Toll",
      "condition": null,
      "action": "Pre-cast Consecration next to the boss, taunt with Hand of Reckoning on the pull, then chain Avenger's Shield, Avenging Wrath, and Divine Toll before settling into your normal builder-spender rotation."
    },
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Sync Avenging Wrath with Divine Toll",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 375576,
        "spell_name": "Divine Toll",
        "required_spell_id": 31884,
        "required_spell_name": "Avenging Wrath",
        "window_s": 12
      },
      "action": "Press Avenging Wrath when Divine Toll is within about ten seconds of being ready so the two land together, then fire Divine Toll inside the Avenging Wrath window for maximum Holy Power and damage."
    },
    {
      "type": "rotation",
      "priority": "critical",
      "description": "Never overcap Holy Power",
      "condition": null,
      "action": "Spend Holy Power on Shield of the Righteous at 3-5 charges before it caps; sitting at maximum Holy Power wastes every builder you cast afterward and drops your active mitigation uptime."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Keep Judgment and Blessed Hammer rolling",
      "condition": null,
      "action": "Keep Judgment and Blessed Hammer (or Hammer of the Righteous) on cooldown as your primary Holy Power generators, filling remaining globals with Avenger's Shield and Consecration."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Always Be Casting",
      "condition": null,
      "action": "Never let a global cooldown go to waste; missing 10-20% of your casts starves Holy Power generation, cooldown reduction, and mitigation, so always hit something that is off cooldown."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Use Divine Toll at 0 Holy Power",
      "condition": null,
      "action": "Fire Divine Toll on cooldown, ideally when you are at 0 Holy Power, so none of the Holy Power it generates is wasted to overcapping."
    },
    {
      "type": "positioning",
      "priority": "medium",
      "description": "Keep Consecration under the boss",
      "condition": null,
      "action": "Stand in your own Consecration on the boss to gain its damage reduction and Holy Power synergy; reapply it as a filler whenever you move out of the patch."
    },
    {
      "type": "cd_hold",
      "priority": "high",
      "description": "Save Ardent Defender for big damage",
      "condition": null,
      "action": "Hold Ardent Defender for telegraphed tankbusters or high-damage phases rather than pressing it on cooldown; it is your biggest 50% damage reduction and should cover the scariest moment available."
    }
  ],
