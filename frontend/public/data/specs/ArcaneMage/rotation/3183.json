  "major_cooldowns": [
    {
      "name": "Arcane Surge",
      "spell_id": 365350,
      "cooldown": 90,
      "duration": 15,
      "align_with_bloodlust": true,
      "opener_priority": 1,
      "usage_rule": "Open the burst window with Arcane Surge; it spends all your mana for a 35% spell damage buff and a massive mana refund, so never sit on it because holding it starves the rest of your rotation of mana."
    },
    {
      "name": "Touch of the Magi",
      "spell_id": 321507,
      "cooldown": 45,
      "duration": 12,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "usage_rule": "Cast Touch of the Magi inside the Arcane Surge window (mid-air after an Arcane Barrage as Spellslinger, or late in Surge to cover Arcane Soul as Sunfury), then dump as much damage as possible into the target before the debuff detonates."
    },
    {
      "name": "Evocation",
      "spell_id": 12051,
      "cooldown": 90,
      "duration": 2,
      "align_with_bloodlust": false,
      "usage_rule": "Use Evocation only when you are out of mana, have no procs to spend, and Arcane Surge is not coming up shortly, since Surge will refund your mana for free."
    },
    {
      "name": "Presence of Mind",
      "spell_id": 205025,
      "cooldown": 60,
      "duration": 10,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Use Presence of Mind to fire instant Arcane Blasts during heavy movement or to squeeze extra casts into a burst window; talent-gated, so zero casts is fine if you did not take it."
    }
  ],
  "rules": [
    {
      "type": "opener",
      "priority": "critical",
      "description": "Open with Arcane Surge then Touch of the Magi",
      "condition": null,
      "action": "Pop stat trinkets and potions, cast Arcane Surge, then cast Arcane Barrage and follow it with Touch of the Magi mid-air so Touch lands inside the Surge buff window."
    },
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Touch of the Magi inside Arcane Surge",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 321507,
        "spell_name": "Touch of the Magi",
        "required_spell_id": 365350,
        "required_spell_name": "Arcane Surge",
        "window_s": 15
      },
      "action": "Always line your first Touch of the Magi up with the Arcane Surge window so both cooldowns detonate together; only the off-Surge 45-second Touch is cast on its own."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Never sit on Arcane Surge or Touch of the Magi",
      "condition": null,
      "action": "Send Arcane Surge and Touch of the Magi as close to on cooldown as possible; both are short cooldowns and holding them starves your mana and Arcane Salvo, cascading into lost damage."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Spend Arcane Charges with Barrage to manage mana",
      "condition": null,
      "action": "When mana runs low, cast Arcane Barrage at 4 Arcane Charges to throttle your spend and keep casting; running out of mana is fine, just Barrage and continue the priority."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Dump Arcane Salvo with Barrage at max stacks",
      "condition": null,
      "action": "Cast Arcane Barrage at max Arcane Salvo stacks (around 20-25 depending on build) with 4 Arcane Charges to convert stored Salvo into a hard-hitting, cleaving Barrage."
    },
    {
      "type": "cd_hold",
      "priority": "medium",
      "description": "Hold Salvo and Barrage for incoming Touch",
      "condition": null,
      "action": "If Touch of the Magi or Arcane Surge will be ready within about 4 seconds, hold your big Arcane Barrage so the spend lands inside the cooldown window instead of just before it."
    },
    {
      "type": "aoe_switch",
      "priority": "medium",
      "description": "Add Arcane Orb and Pulse on multiple targets",
      "condition": null,
      "action": "On 3 or more targets, weave Arcane Orb after Barrage with Clearcasting and use Arcane Pulse to accelerate Arcane Salvo and Arcane Charge generation across the pack."
    },
    {
      "type": "rotation",
      "priority": "low",
      "description": "Keep Prismatic Barrier active",
      "condition": null,
      "action": "Refresh Prismatic Barrier whenever it falls off; the 0.5s cast costs almost no uptime and a dead mage deals zero damage."
    }
  ],
