    },
    {
      "name": "Sigil of Spite",
      "spell_id": 390163,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Use on cooldown to generate Soul Fragments, ideally synced with Fiery Brand if talented into Fiery Demise; as Aldrachi Reaver use it to activate Art of the Glaive when no Reaver's Glaive is available."
    }
  ],
  "rules": [
    {
      "type": "rotation",
      "priority": "high",
      "description": "Keep generators on cooldown",
      "condition": null,
      "action": "Prioritize Fracture and your other generators on cooldown when a priority conflict arises, since Soul Fragment and Fury generation feed the Hero tree procs that drive your damage."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Spend Spirit Bomb at high Soul count",
      "condition": null,
      "action": "Always cast Spirit Bomb with 5 or more Souls rather than spending them piecemeal; spending spenders at maximum Soul count gives the most efficiency per global cooldown."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Avoid overcapping Fury and Souls",
      "condition": null,
      "action": "Build and spend in waves so you do not overcap either resource; weave in Soul Cleave and Spirit Bomb to bleed off Souls and Fury before your generators come back up."
    },
    {
      "type": "cooldown_pairing",
      "priority": "medium",
      "description": "Sync fire cooldowns with Fiery Brand",
      "condition": null,
      "action": "If you are talented into Fiery Demise, cast Fiery Brand first and then fire Soul Carver, Sigil of Spite, and Fel Devastation into the Fiery Brand window to amplify their fire damage."
    },
    {
      "type": "cd_hold",
      "priority": "medium",
      "description": "Do not overwrite active Metamorphosis",
      "condition": null,
      "action": "Hold Metamorphosis if you are already in a Metamorphosis from a proc with more than 5 seconds left, because recasting overwrites the duration instead of extending it and wastes the cooldown."
    },
    {
      "type": "opener",
      "priority": "medium",
      "description": "Open by getting all cooldowns rolling",
      "condition": null,
      "action": "Open with Infernal Strike into the pack, then chain Fracture, Immolation Aura, and your sigils to build Souls, reaching a Spirit Bomb and Metamorphosis once enemies are grouped to get every cooldown rolling early."
    },
    {
      "type": "rotation",
      "priority": "low",
      "description": "Pause Fracture at full Voidfall stacks",
      "condition": null,
      "action": "As Annihilator, avoid pressing Fracture while at full Voidfall stacks or while spending them since you cannot generate; instead lean on Fracture when you are about to proc the third stack."
    }
  ],
