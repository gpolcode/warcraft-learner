        "spell_name": "Convoke the Spirits",
        "required_spell_id": 106951,
        "required_spell_name": "Berserk",
        "window_s": 20
      },
      "action": "Line up Convoke the Spirits with each Berserk window; cast it at low combo points with your bleeds already applied so its random casts roll into direct damage."
    },
    {
      "type": "opener",
      "priority": "high",
      "description": "Opener: Rake, build, Rip, then cooldowns",
      "condition": null,
      "action": "Open with a stealthed Rake, Shred to 5 combo points, fire Tiger's Fury and Berserk, apply Rip, then cast Convoke the Spirits and Feral Frenzy and spend with Ferocious Bite at 5 combo points and 50 energy."
    },
    {
      "type": "rotation",
      "priority": "critical",
      "description": "Keep Rip and Rake up at all times",
      "condition": null,
      "action": "Maintain Rip and Rake on the target without letting them drop; refresh inside the pandemic window and prefer refreshing during Tiger's Fury to snapshot the damage bonus into the full bleed."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Ferocious Bite at 5 CP and 50 energy",
      "condition": null,
      "action": "Only cast Ferocious Bite at 5 combo points with at least 50 energy so it spends the full 25 bonus energy for maximum damage, and never bite while Rip needs applying."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Avoid wasting energy and Tiger's Fury",
      "condition": null,
      "action": "Pool below 50 energy as Tiger's Fury approaches so no energy is wasted on its regen burst, and dump energy if Tiger's Fury is more than 3 seconds out and you are above 80 percent energy."
    },
    {
      "type": "aoe_switch",
      "priority": "high",
      "description": "Primal Wrath and Swipe at 2+ targets",
      "condition": null,
      "action": "On 2 or more targets, spend combo points with Primal Wrath to spread Rip and build with Swipe instead of Shred; keep Rake applied across targets and use Ferocious Bite on Apex Predator's Craving procs."
    },
    {
      "type": "positioning",
      "priority": "medium",
      "description": "Stay behind the target for Shred",
      "condition": null,
      "action": "Remain behind the boss so Shred deals its full bonus damage and cannot be parried; ask the tank to face the boss away from the raid if you cannot reach the rear."
    }
