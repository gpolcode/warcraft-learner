      "usage_rule": "Replaces Berserk when talented; cast on cooldown with Tiger's Fury and Convoke active and exploit the in-combat Prowl to land an empowered stealth Rake during the window."
    },
    {
      "name": "Tiger's Fury",
      "spell_id": 5217,
      "cooldown": 30,
      "duration": 10,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "usage_rule": "Press on cooldown when below roughly 50 energy so none is wasted, and apply or refresh Rip and Rake during the buff to snapshot the damage bonus into the full bleed duration."
    },
    {
      "name": "Convoke the Spirits",
      "spell_id": 391528,
      "cooldown": 120,
      "duration": 4,
      "align_with_bloodlust": false,
      "opener_priority": 4,
      "talent_gated": true,
      "usage_rule": "Cast at low combo points with all debuffs already applied and synced inside the Berserk and Tiger's Fury window so its random casts are spent on direct damage rather than re-applying bleeds."
    },
    {
      "name": "Feral Frenzy",
      "spell_id": 274837,
      "cooldown": 45,
      "align_with_bloodlust": false,
      "opener_priority": 5,
      "talent_gated": true,
      "usage_rule": "Cast on cooldown at 0-2 combo points (up to 4 inside Berserk) to avoid overcapping the combo points it generates; this is the Feral Frenzy talent variant, not the Frantic Frenzy haste passive."
    }
  ],
  "rules": [
