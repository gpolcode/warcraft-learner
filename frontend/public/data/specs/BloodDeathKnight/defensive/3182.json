  "defensives": [
    {
      "name": "Vampiric Blood",
      "spell_id": 55233,
      "cooldown": 90,
      "duration": 10,
      "usage_rule": "Use proactively ahead of heavy incoming damage to boost your maximum health and the healing of your Death Strikes; it is your highest-impact defensive, so keep it close to on cooldown rather than hoarding it.",
      "talent_gated": false
    },
    {
      "name": "Icebound Fortitude",
      "spell_id": 48792,
      "cooldown": 180,
      "duration": 8,
      "usage_rule": "Press before a large physical or magical hit for a flat 30% damage reduction and stun immunity; reserve it for tankbusters or moments Vampiric Blood alone cannot cover.",
      "talent_gated": false
    },
    {
      "name": "Anti-Magic Shell",
      "spell_id": 48707,
      "cooldown": 60,
      "duration": 5,
      "usage_rule": "Use to absorb a telegraphed burst of magic damage and to generate Runic Power from the absorbed damage; press it just before the magic hit lands rather than reactively.",
      "talent_gated": false
    },
    {
      "name": "Rune Tap",
      "spell_id": 194679,
      "cooldown": 25,
      "duration": 3,
      "usage_rule": "Spend a charge for a 20% damage reduction on predictable melee swings or smaller hits; its short recharge lets you use it frequently to smooth out steady tank damage.",
      "talent_gated": false
    },
    {
      "name": "Lichborne",
      "spell_id": 49039,
      "cooldown": 120,
      "duration": 10,
      "usage_rule": "Use to gain immunity to charm, fear, and sleep effects, or as an extra layer of survivability when combined with Death Coil self-healing during dangerous windows.",
      "talent_gated": false
    },
    {
      "name": "Anti-Magic Zone",
      "spell_id": 51052,
      "cooldown": 120,
      "duration": 8,
      "usage_rule": "Drop on the raid before a wide magic-damage event to reduce incoming magic damage for everyone standing inside; coordinate placement with your group so allies stack in it.",
      "talent_gated": false
    }
  ],
