        "hold_window_s": 6
      },
      "action": "Always cast Call Dreadstalkers and put it on cooldown before pressing Summon Demonic Tyrant so the Tyrant extends your Dreadstalkers and locks in the guaranteed duration buff."
    },
    {
      "type": "cd_hold",
      "priority": "high",
      "description": "Bank 2 Demonic Cores before Tyrant",
      "condition": null,
      "action": "Hold at least 2 Demonic Core charges heading into each Summon Demonic Tyrant so you can immediately spend Demonbolt into Hand of Gul'dan and resummon Wild Imps while the Tyrant is active."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Never overcap Soul Shards",
      "condition": null,
      "action": "Spend Soul Shards before reaching the cap of 5, prioritizing Call Dreadstalkers then Hand of Gul'dan, and never fire a generator while sitting at 4 with a Demonbolt or 5 shards queued."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Maximize demons summoned for Tyrant",
      "condition": null,
      "action": "Summon every available demon (Dreadstalkers, Grimoire pet, Doomguard, and a full set of Wild Imps) before Summon Demonic Tyrant because its damage modifier scales per active demon."
    },
    {
      "type": "aoe_switch",
      "priority": "high",
      "description": "Implode at 6 Wild Imps on AoE",
      "condition": null,
      "action": "On two or more targets, fire Implosion only when you have the full 6 Wild Imps active to maximize its damage, and add Summon Doomguard to the rotation for sustained cleave."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Spread Doom for extra AoE",
      "condition": null,
      "action": "On multiple targets, weave Demonbolt onto additional enemies to apply Doom to each, since every Doom application is its own independent damage source."
    },
    {
      "type": "cooldown_pairing",
      "priority": "medium",
      "description": "Pool Demonbolt with Power Siphon",
      "condition": null,
      "action": "Use Power Siphon to convert excess Wild Imps into Demonic Core charges right before a burst window so Demonbolt can rebuild Soul Shards quickly under Summon Demonic Tyrant."
    }
