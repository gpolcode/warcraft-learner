  "major_cooldowns": [
    {
      "name": "Colossus Smash",
      "spell_id": 167105,
      "cooldown": 45,
      "duration": 10,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "usage_rule": "Keep on cooldown at all times as the spec's central debuff window; never delay it without a strong reason such as an incoming add wave, since delaying it desyncs every other cooldown."
    },
    {
      "name": "Warbreaker",
      "spell_id": 262161,
      "cooldown": 45,
      "duration": 10,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "usage_rule": "When talented this replaces Colossus Smash, applying the same armor-shred debuff to all nearby targets; use it on cooldown exactly as you would Colossus Smash (talent_gated alternative to Colossus Smash)."
    },
    {
      "name": "Avatar",
      "spell_id": 107574,
      "cooldown": 90,
      "duration": 20,
      "align_with_bloodlust": true,
      "opener_priority": 1,
      "usage_rule": "Press shortly before or together with Colossus Smash so its damage bonus overlaps the debuff window; Anger Management cooldown reduction keeps it roughly aligned with Colossus Smash, so use it on cooldown."
    },
    {
      "name": "Bladestorm",
      "spell_id": 227847,
      "cooldown": 90,
      "duration": 6,
      "align_with_bloodlust": false,
      "usage_rule": "Used by Slayer builds during the Colossus Smash window for single- and multi-target damage; its unique cooldown reduction means it will not always realign, so plan whether to use or save it before each Colossus Smash."
    },
    {
      "name": "Ravager",
      "spell_id": 228920,
      "cooldown": 90,
      "duration": 12,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Colossus builds drop it just before Colossus Smash so its ticks land inside the debuff window; talent_gated since not every build takes it."
    },
    {
      "name": "Demolish",
      "spell_id": 436358,
      "cooldown": 45,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Colossus hero-talent finisher used during Colossus Smash at 10 stacks of Colossal Might, optionally delayed to the last seconds of the debuff to build extra stacks; talent_gated to the Colossus tree."
    },
    {
      "name": "Champion's Spear",
      "spell_id": 376079,
      "cooldown": 90,
      "duration": 4,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "A talented class-tree throw used inside the Colossus Smash window for burst and to tether enemies in place; talent_gated since it is an optional class talent (best-guess timing, primarily a damage cooldown despite its utility framing)."
    },
    {
      "name": "Sweeping Strikes",
      "spell_id": 260708,
      "cooldown": 30,
      "duration": 15,
      "align_with_bloodlust": false,
      "usage_rule": "On 2 or more targets, press it to cleave your single-target rotation onto a second enemy; with Broad Strokes talented, only cast it manually after the auto-granted charges expire to avoid overcapping."
    }
  ],
  "rules": [
    {
      "type": "cooldown_pairing",
      "priority": "critical",
      "description": "Bladestorm only inside Colossus Smash",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 227847,
        "spell_name": "Bladestorm",
        "required_spell_id": 167105,
        "required_spell_name": "Colossus Smash",
        "window_s": 10
      },
      "action": "Always cast Bladestorm during an active Colossus Smash debuff so its hits are amplified by the armor shred; firing Bladestorm outside the window is a major DPS loss."
    },
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Avatar with or just before Colossus Smash",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 107574,
        "spell_name": "Avatar",
        "required_spell_id": 167105,
        "required_spell_name": "Colossus Smash",
        "window_s": 6
      },
      "action": "Press Avatar in the same window as Colossus Smash so its damage bonus overlaps the debuff; let Anger Management keep the two aligned rather than drifting them apart."
    },
    {
      "type": "rotation",
      "priority": "critical",
      "description": "Keep Colossus Smash and Avatar on cooldown",
      "condition": null,
      "action": "Use Colossus Smash, Avatar, and Bladestorm or Demolish on cooldown as much as possible; delaying any one of them desyncs the rest, so only hold a cooldown for an imminent add wave or burst phase."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Maximize uptime and avoid wasting Rage",
      "condition": null,
      "action": "Stay on target to keep auto-attacks flowing since they generate most of your Rage, and spend Rage on Mortal Strike and Execute rather than letting it cap or decay between pulls."
    },
    {
      "type": "opener",
      "priority": "medium",
      "description": "Open with Charge into Avatar plus Colossus Smash",
      "condition": null,
      "action": "Open every pull with Charge for the extra Rage, then immediately go into Avatar and Colossus Smash followed by your hero-talent burst (Bladestorm or Demolish) inside the debuff window."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Execute only during Sudden Death outside Execute phase",
      "condition": null,
      "action": "Above the Execute health threshold, only cast Execute when Sudden Death procs; otherwise spend Rage on Mortal Strike and Slam, then switch to spamming Execute once the target drops into Execute range."
    },
    {
      "type": "aoe_switch",
      "priority": "high",
      "description": "Sweeping Strikes and Cleave at 2+ targets",
      "condition": null,
      "action": "On 2 or more targets, maintain Sweeping Strikes to mirror your single-target damage and weave Cleave into the rotation; on Colossus, keep Rend applied and route Demolish through the Colossus Smash window."
    },
    {
      "type": "positioning",
      "priority": "medium",
      "description": "Stay in melee and use mobility to keep uptime",
      "condition": null,
      "action": "Use Charge after a target finishes moving and Heroic Leap to exit damage at the last moment, minimizing time off target so Rage generation and GCD usage never stall."
    }
  ],
