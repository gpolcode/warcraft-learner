      "type": "rotation",
      "priority": "critical",
      "description": "Keep Vampiric Touch active",
      "condition": null,
      "action": "Maintain Vampiric Touch on the primary target at all times to keep Mastery: Shadow Weaving ramped, refreshing it with Tentacle Slam or a hardcast before it expires."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Use Voidform on cooldown",
      "condition": null,
      "action": "Cast Void Eruption as soon as it is available so it stays aligned with Power Infusion, Halo and Void Torrent across the fight."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Cast Halo early in each window (Archon)",
      "condition": null,
