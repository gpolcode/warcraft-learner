      "type": "cooldown_pairing",
      "priority": "medium",
      "description": "Sync trinkets and potion with Power Infusion",
      "condition": null,
      "action": "Hold your on-use trinkets and damage potion for the Power Infusion / Voidform window so their value overlaps your haste burst."
    },
