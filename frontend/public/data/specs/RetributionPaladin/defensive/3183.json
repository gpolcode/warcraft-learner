  "defensives": [
    {
      "name": "Shield of Vengeance",
      "spell_id": 184662,
      "cooldown": 90,
      "duration": 15,
      "usage_rule": "Press proactively before incoming damage to absorb a large amount and release a burst of damage when it expires, so it doubles as a near free DPS cooldown.",
      "talent_gated": false
    },
    {
      "name": "Divine Shield",
      "spell_id": 642,
      "cooldown": 300,
      "duration": 8,
      "usage_rule": "Use to fully immune unavoidable lethal damage or to drop a deadly debuff; cancel it early once the threat passes to minimize the Forbearance lockout on Lay on Hands and Blessing of Protection.",
      "talent_gated": false
    },
    {
      "name": "Divine Protection",
      "spell_id": 498,
      "cooldown": 60,
      "duration": 8,
      "usage_rule": "Press before predictable magic or mixed damage events for a 20% damage reduction; its short cooldown means you can use it on most repeating raid hits.",
      "talent_gated": false
    },
    {
      "name": "Lay on Hands",
      "spell_id": 633,
      "cooldown": 600,
      "duration": null,
      "usage_rule": "Reserve for an emergency when you or an ally is about to die, fully restoring their health; it triggers Forbearance, so it cannot be chained with Divine Shield or Blessing of Protection.",
      "talent_gated": false
    },
    {
      "name": "Blessing of Protection",
      "spell_id": 1022,
      "cooldown": 300,
      "duration": 10,
      "usage_rule": "Cast on yourself or an ally to immune all physical damage during a heavy melee hit; it does not block magic and triggers Forbearance on the target.",
      "talent_gated": false
    },
    {
      "name": "Blessing of Spellwarding",
      "spell_id": 204018,
      "cooldown": 180,
      "duration": 10,
      "usage_rule": "If talented in place of Blessing of Protection, cast to immune a dangerous magical hit on yourself or an ally; it shares Forbearance and does not block physical damage.",
      "talent_gated": true
    }
  ],
