  "major_cooldowns": [
    {
      "name": "Breath of Eons",
      "spell_id": 442204,
      "cooldown": 120,
      "duration": 10,
      "align_with_bloodlust": true,
      "opener_priority": 3,
      "usage_rule": "Cast roughly on cooldown after Ebon Might and two Prescience applications are out, aiming the 10-second Temporal Wounds window over allied burst and major damage moments; choose a short, safe flight path that only needs to graze the boss hitbox."
    },
    {
      "name": "Ebon Might",
      "spell_id": 395152,
      "cooldown": 30,
      "duration": 10,
      "align_with_bloodlust": false,
      "opener_priority": 1,
      "usage_rule": "Cast immediately at the start of combat and re-cast with no more than 3-4 seconds remaining to pandemic the buff, since Empower casts only extend Ebon Might while it is already active."
    },
    {
      "name": "Tip the Scales",
      "spell_id": 370553,
      "cooldown": 120,
      "align_with_bloodlust": false,
      "opener_priority": 4,
      "usage_rule": "Press off-GCD to make your next Empower instant, defaulting to pairing it with Max Rank Fire Breath; with the Temporal Burst hero build treat it as a major DPS cooldown and align it with Breath of Eons."
    },
    {
      "name": "Time Skip",
      "spell_id": 404977,
      "cooldown": 180,
      "duration": 3,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Talent choice over Interwoven Threads; first channel it in the opener after your initial Fire Breath and Upheaval, then use it on cooldown when it will refund the full duration on Fire Breath, Upheaval, Prescience, and Breath of Eons."
    },
    {
      "name": "Fire Breath",
      "spell_id": 357208,
      "cooldown": 30,
      "align_with_bloodlust": false,
      "opener_priority": 5,
      "usage_rule": "Cast at Max Rank while Ebon Might is active to maximize Leaping Flames and extend buffs, but drop to Rank 1 if upranking would let Ebon Might or Duplicate expire (under 4-5 seconds remaining)."
    },
    {
      "name": "Upheaval",
      "spell_id": 396286,
      "cooldown": 40,
      "align_with_bloodlust": false,
      "usage_rule": "Cast at Rank 1 in single target while Ebon Might is up to extend buffs; uprank only in AoE when the wider radius is needed to hit more enemies."
    }
  ],
  "rules": [
    {
      "type": "opener",
      "priority": "critical",
      "description": "Open Ebon Might then Prescience then Breath",
      "condition": null,
      "action": "At pull, cast Ebon Might first to buff the raid immediately, apply Prescience to your two best burst targets, then send Breath of Eons followed by Tip the Scales into Max Rank Fire Breath."
    },
    {
      "type": "rotation",
      "priority": "critical",
      "description": "Keep Ebon Might active before Empowers",
      "condition": null,
      "action": "Always have Ebon Might up before casting Fire Breath, Upheaval, or Eruption; spending these abilities outside Ebon Might wastes their buff-extension and is a major loss."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Maintain Prescience on allied DPS",
      "condition": null,
      "action": "Keep Prescience rolling on your strongest DPS allies and avoid capping charges; feel free to cast it outside Ebon Might purely to generate Essence Burst since it does not extend Ebon Might."
    },
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Tip the Scales into Max Rank Fire Breath",
      "condition": null,
      "action": "Press Tip the Scales right before Fire Breath so the Empower goes off instantly at Max Rank, gaining full Leaping Flames value and letting you cast on the move."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Spend Essence Burst before it caps",
      "condition": null,
      "action": "Essence Burst caps at 2 stacks, so spend it on Eruption before casting generators like Prescience or Living Flame to avoid wasting resources."
    },
    {
      "type": "cd_hold",
      "priority": "medium",
      "description": "Sync Time Skip with Tip the Scales",
      "condition": null,
      "action": "With Time Skip and Temporal Burst talented, keep Tip the Scales and Time Skip in sync (use a cancelaura macro) so each Time Skip channel lands during your Temporal Burst window for stacking cooldown reduction."
    },
    {
      "type": "aoe_switch",
      "priority": "medium",
      "description": "Spread Bombardments on 2+ targets",
      "condition": null,
      "action": "As Scalecommander, pool resources before your Empowers, build two Mass Eruption stacks, then cast Eruption on two separate high-health targets to keep Bombardments rolling on both and maximize Breath of Eons cooldown reduction."
    },
    {
      "type": "positioning",
      "priority": "medium",
      "description": "Plan a safe Breath of Eons flight path",
      "condition": null,
      "action": "Before each Breath of Eons, pick the shortest path that avoids mechanics and ends where you need to be next; you only need to clip the enemy hitbox, not fly through its center."
    }
  ],
