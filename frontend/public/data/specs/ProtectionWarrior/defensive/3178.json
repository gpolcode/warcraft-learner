      "name": "Shield Wall",
      "spell_id": 871,
      "cooldown": 180,
      "duration": 8,
      "usage_rule": "Press proactively to smooth out a large spike of incoming damage or a tankbuster; its long cooldown means plan its use around the heaviest damage events of the fight.",
      "talent_gated": false
    },
    {
      "name": "Last Stand",
      "spell_id": 12975,
      "cooldown": 120,
      "duration": 15,
      "usage_rule": "Use to instantly gain a large block of temporary health when you are about to drop dangerously low; pairs well with a heal landing inside the window.",
      "talent_gated": false
    },
    {
      "name": "Rallying Cry",
      "spell_id": 97462,
      "cooldown": 180,
      "duration": 10,
      "usage_rule": "Use as a raid cooldown to grant the whole group temporary health before an unavoidable burst of raid-wide damage.",
      "talent_gated": false
    },
    {
      "name": "Spell Reflection",
      "spell_id": 23920,
      "cooldown": 25,
      "duration": 5,
      "usage_rule": "Press just before a reflectable magic cast or tankbuster to reduce magic damage taken and bounce single-target spells back at the caster.",
      "talent_gated": false
    },
    {
      "name": "Shield Block",
      "spell_id": 2565,
      "cooldown": 16,
      "duration": 6,
      "usage_rule": "Keep close to 100% uptime by refreshing whenever it has 10 seconds or less remaining to block incoming physical melee damage.",
      "talent_gated": false
    },
    {
      "name": "Ignore Pain",
      "spell_id": 190456,
      "cooldown": 1,
      "duration": 12,
      "usage_rule": "Dump excess rage into this absorb to avoid wasting rage and to soften physical and magic spikes; keep rage below the cap by spending into it.",
      "talent_gated": false
    },
