    },
    {
      "name": "Last Stand",
      "spell_id": 12975,
      "cooldown": 120,
      "duration": 15,
      "usage_rule": "Use to instantly gain a large block of temporary health when you are about to drop dangerously low; pairs well with a heal landing inside the window.",
