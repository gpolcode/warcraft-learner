  "major_cooldowns": [
    {
      "name": "Apotheosis",
      "spell_id": 200183,
      "cooldown": 120,
      "duration": 20,
      "align_with_bloodlust": false,
      "opener_priority": 1,
      "usage_rule": "Use on cooldown to reset and cheapen your Holy Words; as Archon always pair it with Halo, and enter with at least one Holy Word: Serenity and one Holy Word: Sanctify charge ready so every global during the window casts or reduces a Holy Word."
    },
    {
      "name": "Halo",
      "spell_id": 120517,
      "cooldown": 40,
      "duration": 10,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "usage_rule": "As Archon use Halo early as raid damage lands, ideally inside the Apotheosis window, to apply the 10-second amplified-healing buff to your allies; pool Holy Words to benefit from the bonus healing without capping charges."
    },
    {
      "name": "Divine Hymn",
      "spell_id": 64843,
      "cooldown": 180,
      "duration": 8,
      "align_with_bloodlust": false,
      "usage_rule": "Save for heavy raid-wide damage spikes; it can be channeled while line-of-sight of allies and deals bonus healing in Mythic+, so use it freely as a throughput cooldown in dungeons."
    },
    {
      "name": "Divine Word",
      "spell_id": 372760,
      "cooldown": 60,
      "duration": 15,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Cast immediately before the matching Holy Word to empower it; the Chastise build syncs Divine Word with Holy Word: Chastise (and Empyreal Blaze if talented) to enter Divine Favor: Chastise for a damage window."
    },
    {
      "name": "Holy Word: Chastise",
      "spell_id": 88625,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Keep on cooldown for damage and to trigger Divine Favor: Chastise when buffed by Divine Word; Apotheosis can reset it for back-to-back Divine Word windows."
    },
    {
      "name": "Empyreal Blaze",
      "spell_id": 372616,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Cast just before Divine Word so you spend no global on a non-damage cast inside the buff window; it also extends Holy Fire, so weave it on cooldown when talented."
    }
  ],
  "rules": [
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Pair Halo with Apotheosis as Archon",
      "condition": {
        "kind": "cast_without_prior",
