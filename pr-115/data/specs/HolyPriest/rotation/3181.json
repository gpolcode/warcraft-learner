  "major_cooldowns": [
    {
      "name": "Apotheosis",
      "spell_id": 200183,
      "cooldown": 120,
      "duration": 20,
      "align_with_bloodlust": false,
      "opener_priority": 1,
      "usage_rule": "Use on cooldown to reset and cheapen your Holy Words; as Archon always pair it with Halo, and enter with at least one Holy Word: Serenity and one Holy Word: Sanctify charge ready so every global during the window casts or reduces a Holy Word."
    },
    {
      "name": "Halo",
      "spell_id": 120517,
      "cooldown": 40,
      "duration": 10,
      "align_with_bloodlust": false,
      "opener_priority": 2,
      "usage_rule": "As Archon use Halo early as raid damage lands, ideally inside the Apotheosis window, to apply the 10-second amplified-healing buff to your allies; pool Holy Words to benefit from the bonus healing without capping charges."
    },
    {
      "name": "Divine Hymn",
      "spell_id": 64843,
      "cooldown": 180,
      "duration": 8,
      "align_with_bloodlust": false,
      "usage_rule": "Save for heavy raid-wide damage spikes; it can be channeled while line-of-sight of allies and deals bonus healing in Mythic+, so use it freely as a throughput cooldown in dungeons."
    },
    {
      "name": "Divine Word",
      "spell_id": 372760,
      "cooldown": 60,
      "duration": 15,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Cast immediately before the matching Holy Word to empower it; the Chastise build syncs Divine Word with Holy Word: Chastise (and Empyreal Blaze if talented) to enter Divine Favor: Chastise for a damage window."
    },
    {
      "name": "Holy Word: Chastise",
      "spell_id": 88625,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Keep on cooldown for damage and to trigger Divine Favor: Chastise when buffed by Divine Word; Apotheosis can reset it for back-to-back Divine Word windows."
    },
    {
      "name": "Empyreal Blaze",
      "spell_id": 372616,
      "cooldown": 60,
      "align_with_bloodlust": false,
      "talent_gated": true,
      "usage_rule": "Cast just before Divine Word so you spend no global on a non-damage cast inside the buff window; it also extends Holy Fire, so weave it on cooldown when talented."
    }
  ],
  "rules": [
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Pair Halo with Apotheosis as Archon",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 120517,
        "spell_name": "Halo",
        "required_spell_id": 200183,
        "required_spell_name": "Apotheosis",
        "window_s": 20
      },
      "action": "As Archon, cast Halo inside the Apotheosis window so both spells benefit from the bonus healing; using Halo outside Apotheosis sacrifices a large chunk of your focused output."
    },
    {
      "type": "rotation",
      "priority": "high",
      "description": "Keep Holy Words on cooldown",
      "condition": null,
      "action": "Cast Holy Word: Serenity and Holy Word: Sanctify as they come up rather than sitting on charges; only pool a single Serenity charge when you know predictable burst damage is about to hit."
    },
    {
      "type": "cd_hold",
      "priority": "medium",
      "description": "Enter Apotheosis with Holy Words ready",
      "condition": {
        "kind": "hold_cooldown_for_anchor",
        "spell_ids": [
          2050,
          34861
        ],
        "spell_names": [
          "Holy Word: Serenity",
          "Holy Word: Sanctify"
        ],
        "anchor_spell_id": 200183,
        "anchor_spell_name": "Apotheosis",
        "hold_window_s": 15
      },
      "action": "Hold a Holy Word: Serenity charge and a Holy Word: Sanctify charge as Apotheosis approaches so you enter the window with both ready, then spend and regenerate Holy Words aggressively for its full duration."
    },
    {
      "type": "cooldown_pairing",
      "priority": "high",
      "description": "Sync Divine Word with Holy Word: Chastise",
      "condition": {
        "kind": "cast_without_prior",
        "spell_id": 372760,
        "spell_name": "Divine Word",
        "required_spell_id": 88625,
        "required_spell_name": "Holy Word: Chastise",
        "window_s": 5
      },
      "action": "On the Chastise build, cast Divine Word immediately before Holy Word: Chastise (with Empyreal Blaze pre-cast if talented) to enter Divine Favor: Chastise; a Divine Word that does not feed a Holy Word is wasted."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Maximize Holy Word casts in Apotheosis",
      "condition": null,
      "action": "During Apotheosis, make every global cast a spell that either casts a Holy Word or reduces one (Flash Heal, Prayer of Healing, Smite); pre-pool Surge of Light procs so you can chain new Holy Words instead of idling."
    },
    {
      "type": "rotation",
      "priority": "medium",
      "description": "Spend Surge of Light on Prayer of Healing",
      "condition": null,
      "action": "Consume Surge of Light procs with Prayer of Healing whenever possible for extra cooldown reduction; you may hold up to two stacks but avoid overcapping and wasting the free casts."
    },
    {
      "type": "positioning",
      "priority": "low",
      "description": "Cast Divine Hymn while line-of-sight",
      "condition": null,
      "action": "When a mechanic forces you behind a wall, keep channeling Divine Hymn since it heals allies even while you are line-of-sight of dangerous mobs; do not cancel it just to reposition."
    }
  ],
